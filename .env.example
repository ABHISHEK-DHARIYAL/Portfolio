# Public site URL (used for SEO metadata / OG tags)
NEXT_PUBLIC_SITE_URL=https://abhishekdhariyal.dev

# Optional: GitHub username used by the GitHub stats section
NEXT_PUBLIC_GITHUB_USERNAME=ABHISHEK-DHARIYAL

# ---------------------------------------------------------------------------
# Contact + Projects system — all required. See README "Setting up the
# backend (Firebase, Resend, Cloudinary, admin dashboard)" for exact
# step-by-step instructions.
#
# Firestore only — no Firebase Cloud Storage. Resume files are stored in
# Cloudinary instead (see the Cloudinary block further down) — Cloud
# Storage requires enabling a separate product on the Firebase project,
# which isn't available on every plan/setup.
# ---------------------------------------------------------------------------

# Firebase Admin SDK (server-only — never exposed to the browser).
# From Firebase Console → Project Settings → Service Accounts →
# "Generate new private key" (downloads a JSON file with these three values).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Paste the private_key value from that JSON file AS-IS, including the
# -----BEGIN PRIVATE KEY----- / -----END PRIVATE KEY----- lines and \n
# sequences. Wrap the whole thing in quotes if your platform requires it
# for multi-line values.
FIREBASE_PRIVATE_KEY=

# Resend (email delivery). Get a free key at https://resend.com
RESEND_API_KEY=

# Optional — where contact form emails are delivered. Defaults to
# dhariyalabhi@gmail.com if unset.
CONTACT_RECIPIENT_EMAIL=dhariyalabhi@gmail.com

# ---------------------------------------------------------------------------
# Cloudinary — resume PDF storage (replaces Firebase Storage). All three
# values are on your Cloudinary dashboard's home page after signup, no
# separate product to enable. Used only for SIGNED, server-side uploads —
# never sent to the browser. Free tier is generous enough for this.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Admin dashboard (/admin/messages, /admin/projects, /admin/resumes)
#
# There is exactly ONE admin account, defined entirely by the three values
# below. No sign-up flow, no user database — only an email+password that
# exactly match these get in. ADMIN_EMAIL is never shown anywhere on the
# login page or in any API response, on purpose.
# ---------------------------------------------------------------------------

# The single email address allowed to log in. Doesn't need to be a real
# working inbox — it's just a credential, checked against exactly what's
# typed into the login form.
ADMIN_EMAIL=

# The password used alongside ADMIN_EMAIL. Pick something you don't use
# anywhere else — at least 8 characters, longer is better.
ADMIN_PASSWORD=

# A long random string used to sign admin session cookies. Generate one with:
#   openssl rand -hex 32
# Changing this instantly invalidates all existing admin sessions.
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Optional — real-AI mode for the portfolio chatbot (the floating bot icon).
# Leave blank and the chatbot still works: it answers from a built-in engine
# using only the site's own data. With a key set, questions the built-in
# engine can't answer are handed to an Anthropic model, which is instructed
# to answer ONLY from the portfolio's facts. Get a key at
# https://console.anthropic.com — server-side only, never sent to the browser.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional model override (default is a fast, low-cost model).
CHAT_MODEL=
